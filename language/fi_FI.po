msgid ""
"<p>Hi,</p>\n"
"<p>A new user, {user_name}, is registering on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>You may moderate this email: {user_email}.</p>\n"
"<p>This is an automatic message.</p>"
msgstr ""
"<p>Hei,</p>\n"
"<p>Uusi käyttäjä, {user_name}, rekisteröityy sivustolle <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Voit moderoida tämän käyttäjän: {user_email}.</p>\n"
"<p>Tämä on automaattinen viesti.</p>"

#: config/module.config.php:350 config/module.config.php:423
msgid ""
"<p>Hi {user_name},</p>\n"
"<p>You have registered for an account on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Please confirm your registration by following this link: <a href=\"{token_url}\"> {token_url}</a></p>\n"
"<p>If you did not request to join {main_title} / {site_title}, please disregard this email.</p>"
msgstr ""
"<p>Hei {user_name},</p>\n"
"<p>Olet rekisteröinyt käyttäjätilin sivustolle <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Vahvista rekisteröitymisesi seuraamalla tätä linkkiä: <a href=\"{token_url}\"> {token_url}</a></p>\n"
"<p>Jos et pyytänyt liittymistä palveluun {main_title} / {site_title}, jätä tämä viesti huomiotta.</p>"

#: config/module.config.php:358 config/module.config.php:431
msgid ""
"<p>Hi {user_name},</p>\n"
"<p>We are happy to open your account on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Please confirm your email by following this link: <a href=\"{token_url}\">{token_url}</a>.</p>\n"
"<p>You can now log in and discover the site.</p>"
msgstr ""
"<p>Hei {user_name},</p>\n"
"<p>Käyttäjätilisi sivustolla <a href=\"{site_url}\">{site_title}</a> ({main_title}) on nyt avattu.</p>\n"
"<p>Vahvista sähköpostiosoitteesi seuraamalla tätä linkkiä: <a href=\"{token_url}\">{token_url}</a>.</p>\n"
"<p>Voit nyt kirjautua ja tutustua sivustoon.</p>"

#: config/module.config.php:366 config/module.config.php:439
msgid ""
"<p>Hi {user_name},</p>\n"
"<p>You have requested to update email on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Please confirm your email by following this link: <a href=\"{token_url}\">{token_url}</a>.</p>\n"
"<p>If you did not request to update your email on {main_title}, please disregard this email.</p>"
msgstr ""
"<p>Hei {user_name},</p>\n"
"<p>Olet pyytänyt sähköpostiosoitteesi päivittämistä sivustolla <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n"
"<p>Vahvista sähköpostiosoitteesi seuraamalla tätä linkkiä: <a href=\"{token_url}\">{token_url}</a>.</p>\n"
"<p>Jos et pyytänyt sähköpostiosoitteesi päivittämistä palvelussa {main_title}, jätä tämä viesti huomiotta.</p>"
